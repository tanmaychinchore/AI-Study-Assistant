# ==============================================================================
# AI Study Assistant — RAG Service Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ==============================================================================

# --- Groq LLM (Task 8) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TIMEOUT=30

# --- Astra DB (Vector Store) ---
ASTRA_DB_API_ENDPOINT=your_astra_db_api_endpoint_here
ASTRA_DB_APPLICATION_TOKEN=your_astra_db_application_token_here
ASTRA_DB_KEYSPACE=default_keyspace
ASTRA_DB_COLLECTION_NAME=study_chunks

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto

# --- Chunking Configuration ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval Configuration ---
TOP_K=5

# --- RAG Generation Configuration (Task 9) ---
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_TEMPERATURE=0.2
RAG_MAX_COMPLETION_TOKENS=1024

# --- MongoDB Conversation Store (Task 10) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_study_assistant
MONGODB_CONVERSATIONS_COLLECTION=conversations
MONGODB_MESSAGES_COLLECTION=messages
CHAT_MAX_HISTORY_MESSAGES=10

# --- RAG Service ---
RAG_SERVICE_HOST=0.0.0.0
RAG_SERVICE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_SIZE_BYTES=52428800

# --- RAG Evaluation (Task 11) ---
EVAL_MIN_HIT_AT_5=0.70
EVAL_MIN_KEYWORD_COVERAGE=0.70
